{
  "self-replay": {
    "kind": "training",
    "command": [
      "{python}",
      "-m",
      "torch.distributed.run",
      "--standalone",
      "--nproc_per_node=2",
      "-m",
      "experiments.replay_scaled.worker",
      "--data",
      "{data}",
      "--out",
      "{output}",
      "--stop-after",
      "256"
    ],
    "data": "data/replay-scaled",
    "overlay": "self-replay",
    "required_inputs": [
      "data/replay-scaled/plan.json",
      "worker-lease.json"
    ]
  },
